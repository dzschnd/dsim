# eth0 = P2P_R8_R9
ip addr add 10.255.89.2/30 dev eth0
ip link set eth0 up
# eth1 = P2P_R9_R10
ip addr add 10.255.90.1/30 dev eth1
ip link set eth1 up
# eth2 = TRANSIT
ip addr add 10.255.100.9/24 dev eth2
ip link set eth2 up
# eth3 = LAN2 (GW for 10.0.2.x)
ip addr add 10.0.2.1/24 dev eth3
ip link set eth3 up
sysctl -w net.ipv4.ip_forward=1
ip route add 10.0.1.0/24 via 10.255.89.1
ip route add 10.0.3.0/24 via 10.255.90.2
ip route add 10.0.4.0/24 via 10.255.90.2
ip route add 10.0.5.0/24 via 10.255.100.13
ip route add 10.0.6.0/24 via 10.255.100.12
